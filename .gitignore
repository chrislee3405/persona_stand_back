# 1. Environment & Secrets (NEVER COMMIT)
.env
.env.*
!.env.example
*.pem
*.key

# 2. Virtual Environments
venv/
.venv/
env/
ENV/

# 3. Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# 4. Database & Storage
*.sqlite3
*.db
*.log

# 5. OS Specific
.DS_Store
Thumbs.db

# 6. GCP related
adc.json
# 9. Local model probes (may reference personal reference data). Named
# probe_*.py, not *_test.py: they are one-off experiments against the live
# database and Gemini, not tests, and pytest would collect a *_test.py.
probe_*.py

# 10. Real site content and personal reference data -- NEVER COMMIT.
# This repository is PUBLIC. These files hold the owner's real CV, academic
# transcript, residency status, contact details and persona profile.
# audit/ is where scripts/export_content.py writes production table dumps.
audit/
# The seed files carrying that data stay on disk for local seeding (the
# loader skips any file that is absent, so a fresh clone still works).
# Only consent_policy.json, which is public text, is committed. invite_code.json
# stays ignored too: a working invite code does not belong in a public repo.
app/models/seed/*.json
!app/models/seed/consent_policy.json