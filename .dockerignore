.git
.gitignore
.env
.env.*
!.env.example

# GCP application-default credentials. Gitignored, but the Dockerfile does
# `COPY . .`, and docker-compose.yml mounts a real ADC file to this path for
# local development -- so without this line a local `docker build` bakes a
# developer's live Google credentials into an image layer.
adc.json

# Local model probes. Gitignored for the same reason they are excluded here:
# they may reference personal reference data, and they are not part of the
# shipped application.
probe_*.py
venv/
.venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.DS_Store
Thumbs.db
*.log
.idea
.vscode
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.dmypy.json
dmypy.json

# Browser-test entrypoint and fakes are mounted only by the isolated test stack.
tests/
test-results/
pytest-cache-files-*/
requirements-dev.txt
pytest.ini
TESTING.md

image.json
scripts/publish_image.py
scripts/test_publish_image.py
**/__pycache__
