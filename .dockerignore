.git
.gitignore
.env
.env.*
!.env.example

# GCP application-default credentials. Keep these out of the build context
# even though the runtime COPY list is restricted to application directories.
adc.json

# Local model probes. Gitignored for the same reason they are excluded here:
# they may reference personal reference data, and they are not part of the
# shipped application.
probe_*.py
venv/
.venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.DS_Store
Thumbs.db
*.log
.idea
.vscode
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.dmypy.json
dmypy.json

# Browser-test entrypoint and fakes are mounted only by the isolated test stack.
tests/
test-results/
pytest-cache-files-*/
requirements-dev.txt
pytest.ini
TESTING.md

image.json
scripts/publish_image.py
scripts/test_publish_image.py
**/__pycache__

# Git ignores do not protect a Docker context. Only public policy data ships.
app/models/seed/*.json
!app/models/seed/consent_policy.json
**/*.dump
**/*.backup
backups/
exports/
audit/
output/
